{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folium-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Comma-separated list of accepted Google OAuth Client IDs (Web, Android, iOS)
    "GOOGLE_CLIENT_ID": "805229829222-j8b9ij8m76bts34322but1ghhqp5elh3.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folium-d1",
      "database_id": "920a2345-455a-4e2d-84de-b9d8eebece3e",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "SYNC_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 60,
          "period": 60
        }
      },
      {
        "name": "DOWNLOAD_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
